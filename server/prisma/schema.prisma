generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model app_role {
  app_role_id           Int                     @id @default(autoincrement())
  name                  String                  @unique @db.VarChar(100)
  label                 String                  @db.VarChar(100)
  description           String?                 @db.VarChar(500)
  user_account_app_role user_account_app_role[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assignment {
  assignment_id               Int       @id @default(autoincrement())
  assigned_at                 DateTime  @default(now()) @db.Timestamptz(6)
  end_at                      DateTime? @db.Timestamptz(6)
  end_reason                  String?
  employee_id                 Int
  assigned_by_user_account_id Int
  intervention_id             Int
  updated_at                  DateTime? @db.Timestamptz(6)

  user_account user_account @relation(fields: [assigned_by_user_account_id], references: [user_account_id], onDelete: NoAction, onUpdate: NoAction)
  employee     employee     @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction)
  intervention intervention @relation(fields: [intervention_id], references: [intervention_id], onDelete: NoAction, onUpdate: NoAction)
}

model beneficiary {
  beneficiary_id     Int        @id @default(autoincrement())
  first_name         String     @db.VarChar(100)
  last_name          String     @db.VarChar(100)
  phone              String?    @db.VarChar(20)
  email              String?    @db.VarChar(255)
  organisation_notes String?
  is_active          Boolean    @default(true)
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?  @db.Timestamptz(6)
  location           location[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model change_request {
  change_request_id           Int                   @id @default(autoincrement())
  subject                     String                @db.VarChar(255)
  message                     String
  status                      change_request_status @default(pending)
  reviewed_at                 DateTime?             @db.Timestamptz(6)
  decision_reason             String?
  created_at                  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?             @db.Timestamptz(6)
  reviewed_by_user_account_id Int?
  employee_id                 Int
  employee                    employee              @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction)
  user_account                user_account?         @relation(fields: [reviewed_by_user_account_id], references: [user_account_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contract {
  contract_id              Int       @id @default(autoincrement())
  type                     String    @db.VarChar(100)
  start_date               DateTime  @db.Date
  end_date                 DateTime? @db.Date
  weekly_reference_minutes Int
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  employee_id              Int
  employee                 employee  @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction)
}

model employee {
  employee_id              Int                        @id @default(autoincrement())
  is_active                Boolean                    @default(true)
  user_account_id          Int                        @unique
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                  @db.Timestamptz(6)
  assignment               assignment[]
  change_request           change_request[]
  contract                 contract[]
  user_account             user_account               @relation(fields: [user_account_id], references: [user_account_id], onDelete: NoAction, onUpdate: NoAction)
  employee_geographic_area employee_geographic_area[]
  employee_skill           employee_skill[]
  unavailability           unavailability[]
}

model employee_geographic_area {
  employee_id        Int
  geographic_area_id Int
  employee           employee        @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction)
  geographic_area    geographic_area @relation(fields: [geographic_area_id], references: [geographic_area_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([employee_id, geographic_area_id])
}

model employee_skill {
  employee_id Int
  skill_id    Int
  employee    employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction)
  skill       skill    @relation(fields: [skill_id], references: [skill_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([employee_id, skill_id])
}

model geographic_area {
  geographic_area_id       Int                        @id @default(autoincrement())
  name                     String                     @unique @db.VarChar(100)
  description              String?                    @db.VarChar(500)
  is_active                Boolean                    @default(true)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                  @db.Timestamptz(6)
  employee_geographic_area employee_geographic_area[]
  location                 location[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model intervention {
  intervention_id            Int                  @id @default(autoincrement())
  start_at                   DateTime             @db.Timestamptz(6)
  estimated_duration_minutes Int
  status                     intervention_status  @default(unplanned)
  notes                      String?
  location_id                Int
  created_by_user_account_id Int
  service_type_id            Int
  created_at                 DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?            @db.Timestamptz(6)
  assignment                 assignment[]
  user_account               user_account         @relation(fields: [created_by_user_account_id], references: [user_account_id], onDelete: NoAction, onUpdate: NoAction)
  location                   location             @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)
  service_type               service_type         @relation(fields: [service_type_id], references: [service_type_id], onDelete: NoAction, onUpdate: NoAction)
  intervention_skill         intervention_skill[]
}

model intervention_skill {
  intervention_id Int
  skill_id        Int
  intervention    intervention @relation(fields: [intervention_id], references: [intervention_id], onDelete: NoAction, onUpdate: NoAction)
  skill           skill        @relation(fields: [skill_id], references: [skill_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([intervention_id, skill_id])
}

model location {
  location_id        Int             @id @default(autoincrement())
  label              String          @db.VarChar(100)
  address_line       String          @db.VarChar(255)
  postal_code        String          @db.VarChar(5)
  city               String          @db.VarChar(100)
  is_active          Boolean         @default(true)
  geographic_area_id Int
  beneficiary_id     Int
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?       @db.Timestamptz(6)
  intervention       intervention[]
  beneficiary        beneficiary     @relation(fields: [beneficiary_id], references: [beneficiary_id], onDelete: NoAction, onUpdate: NoAction)
  geographic_area    geographic_area @relation(fields: [geographic_area_id], references: [geographic_area_id], onDelete: NoAction, onUpdate: NoAction)
}

model service_type {
  service_type_id Int            @id @default(autoincrement())
  name            String         @unique @db.VarChar(100)
  description     String?        @db.VarChar(500)
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?      @db.Timestamptz(6)
  intervention    intervention[]
}

model skill {
  skill_id           Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(100)
  description        String?              @db.VarChar(500)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @db.Timestamptz(6)
  employee_skill     employee_skill[]
  intervention_skill intervention_skill[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model unavailability {
  unavailability_id Int      @id @default(autoincrement())
  start_at          DateTime @db.Timestamptz(6)
  end_at            DateTime @db.Timestamptz(6)
  reason            String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  employee_id       Int
  employee          employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction)
}

model user_account {
  user_account_id       Int                     @id @default(autoincrement())
  first_name            String                  @db.VarChar(100)
  last_name             String                  @db.VarChar(100)
  email                 String                  @unique @db.VarChar(255)
  password_hash         String
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @db.Timestamptz(6)
  assignment            assignment[]
  change_request        change_request[]
  employee              employee?
  intervention          intervention[]
  user_account_app_role user_account_app_role[]
}

model user_account_app_role {
  app_role_id     Int
  user_account_id Int
  app_role        app_role     @relation(fields: [app_role_id], references: [app_role_id], onDelete: NoAction, onUpdate: NoAction)
  user_account    user_account @relation(fields: [user_account_id], references: [user_account_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([app_role_id, user_account_id])
}

enum change_request_status {
  pending
  approved
  refused
}

enum intervention_status {
  unplanned
  planned
  completed
  cancelled
}
