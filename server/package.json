{
  "name": "server",
  "version": "1.0.0",
  "description": "Server backend to the application Harmonie Domicile (Student project DWWM)",
  "license": "ISC",
  "author": "Kevin Marlin",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:clear": "prisma db execute --file ../database/seeds/00_reset_data.sql",
    "db:seed:references": "prisma db execute --file ../database/seeds/01_reference_data.sql",
    "db:seed:users": "prisma db execute --file ../database/seeds/02_users_employees.sql",
    "db:seed:business": "prisma db execute --file ../database/seeds/03_business_data.sql",
    "db:seed:planning": "prisma db execute --file ../database/seeds/04_planning_data.sql",
    "db:seed": "npm run db:seed:references && npm run db:seed:users && npm run db:seed:business && npm run db:seed:planning",
    "db:reset": "npm run db:clear && npm run db:seed",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
