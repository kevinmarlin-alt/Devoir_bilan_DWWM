{
  "name": "server",
  "version": "1.0.0",
  "description": "Server backend to the application Harmonie Domicile (Student project DWWM)",
  "license": "ISC",
  "author": "Kevin Marlin",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:check": "node src/database/check-database.js",
    "db:clear": "node src/database/run-sql.js ../database/seeds/00_reset_data.sql",
    "db:seed:references": "node src/database/run-sql.js ../database/seeds/01_reference_data.sql",
    "db:seed:users": "node src/database/run-sql.js ../database/seeds/02_users_employees.sql",
    "db:seed:business": "node src/database/run-sql.js ../database/seeds/03_business_data.sql",
    "db:seed:planning": "node src/database/run-sql.js ../database/seeds/04_planning_data.sql",
    "db:seed": "npm run db:seed:references && npm run db:seed:users && npm run db:seed:business && npm run db:seed:planning",
    "db:reset": "npm run db:clear && npm run db:seed",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
